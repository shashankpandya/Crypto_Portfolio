# ── Server ────────────────────────────────────────────────
# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGO_URI=

# Alchemy Web3 Provider (HTTP or WebSocket URL)
ALCHEMY_URL=

# Deployed Smart Contract Address (Transactions contract)
CONTRACT_ADDRESS=

# CoinGecko API Key (Optional, works without it under demo limits)
COINGECKO_API_KEY=

# ── CORS ──────────────────────────────────────────────────
# Dev: leave unset — localhost:5173/3000 are allowed automatically.
# Production: REQUIRED — must be your real deployed frontend origin(s), comma-separated. "*" does NOT work (see note above) and an unset value in production blocks every browser request.
CORS_ORIGIN=https://cryptofolio-web3.netlify.app/

# ── Auth (SIWE + JWT) ─────────────────────────────────────
# Required — /api/auth/verify throws a 500 on every login without this.
JWT_SECRET=
JWT_EXPIRES_IN=24h
AUTH_REQUIRED=false